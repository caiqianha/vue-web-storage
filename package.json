{
  "name": "vue-web-super-storage",
  "version": "1.1.0",
  "description": "Typed localStorage / sessionStorage wrapper for Vue 3 with per-key TTL, namespaces, optional obfuscation, composables, plugin and cross-tab sync",
  "main": "dist/vue-web-storage.umd.js",
  "module": "dist/vue-web-storage.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-web-storage.esm.js",
      "require": "./dist/vue-web-storage.umd.js",
      "default": "./dist/vue-web-storage.esm.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "storage",
    "localStorage",
    "sessionStorage",
    "typescript",
    "expire",
    "ttl",
    "composable"
  ],
  "author": "caiqianha",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "happy-dom": "^15.11.7",
    "rollup": "^4.46.1",
    "rollup-plugin-dts": "^6.2.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/caiqianha/vue-web-storage.git"
  },
  "bugs": {
    "url": "https://github.com/caiqianha/vue-web-storage/issues"
  },
  "homepage": "https://github.com/caiqianha/vue-web-storage#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
